APP_NAME="Billing RTRW Net"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billing_rtrwnet
DB_USERNAME=billing
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_DEFAULT_METHOD=QRIS
TRIPAY_CALLBACK_URL=${APP_URL}/api/webhooks/tripay
TRIPAY_RETURN_URL=${APP_URL}/portal/login
TRIPAY_EXPIRY_MINUTES=1440

FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_TOKEN=
FONNTE_DELAY=2

BILLING_ISOLATION_METHOD=profile
BILLING_ISOLATION_PROFILE=ISOLIR
BILLING_DEFAULT_GRACE_DAYS=5
BILLING_FUP_SAMPLE_MINUTES=5
BILLING_ADMIN_PHONE=
BILLING_TAX_RATE=0

BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14

ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
